<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/file_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_tab_unselected"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="54dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <!-- File Icon / Emoji Badge -->
    <TextView
        android:id="@+id/file_item_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_tab_selected"
        android:gravity="center"
        android:text="🌐"
        android:textSize="18sp" />

    <!-- File Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/file_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="index.html"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/file_item_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Web Entrypoint"
            android:textColor="@color/on_surface_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- File Size -->
    <TextView
        android:id="@+id/file_item_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:fontFamily="monospace"
        android:text="1.2 KB"
        android:textColor="@color/on_surface_subtle"
        android:textSize="11sp" />

</LinearLayout>
