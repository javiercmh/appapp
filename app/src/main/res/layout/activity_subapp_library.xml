<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/library_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/library_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        app:logo="@drawable/ic_app_logo"
        app:menu="@menu/menu_library"
        app:title="@string/title_brand"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:titleTextColor="@color/on_surface" />

    <FrameLayout
        android:id="@+id/library_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.wynh.appapp.LibraryRecyclerView
            android:id="@+id/app_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/discover_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_variant" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/library_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backgroundTint="@color/surface"
        app:itemActiveIndicatorStyle="@style/Widget.AppApp.BottomNavIndicator"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_label_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_library_bottom" />
</LinearLayout>
