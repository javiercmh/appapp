<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/library_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/library_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/actionBarSize" android:paddingStart="8dp" android:paddingEnd="20dp" app:logo="@drawable/ic_app_logo" app:title="@string/title_brand" app:titleTextColor="@color/on_surface" app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" app:menu="@menu/menu_library" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="20dp" android:paddingBottom="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/library_title" android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge" android:textColor="@color/on_surface" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/library_subtitle" android:textAppearance="@style/TextAppearance.Material3.BodyLarge" android:textColor="@color/on_surface_muted" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/new_app" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/library_new" android:textAllCaps="false" app:icon="@drawable/ic_add" app:backgroundTint="@color/primary" android:textColor="@color/on_primary" app:iconTint="@color/on_primary" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/import_app" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:minHeight="48dp" android:text="@string/library_import" android:textAllCaps="false" android:textColor="@color/on_surface" app:icon="@drawable/ic_download" app:iconTint="@color/accent_blue" app:strokeColor="@color/border_color" />
                </LinearLayout>
            </HorizontalScrollView>
            <TextView android:id="@+id/app_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="12dp" android:textAppearance="@style/TextAppearance.Material3.TitleSmall" android:textColor="@color/on_surface_muted" android:accessibilityHeading="true" />
            <TextView android:id="@+id/empty_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:gravity="center" android:text="@string/library_empty" android:textAppearance="@style/TextAppearance.Material3.BodyLarge" android:textColor="@color/on_surface_muted" android:visibility="gone" />
            <LinearLayout android:id="@+id/app_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
