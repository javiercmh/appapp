<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/file_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/code_editor_bg"
    android:orientation="vertical">

    <!-- Top Action Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/file_editor_header"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:minWidth="320dp"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <!-- Back to Hub Button -->
            <ImageButton
                android:id="@+id/editor_btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface" />

            <!-- File Name & Character Count -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/editor_file_name_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="index.html"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/editor_file_stats_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0 chars"
                    android:textColor="@color/on_surface_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Search Action Button -->
            <ImageButton
                android:id="@+id/editor_btn_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_search"
                android:src="@drawable/ic_search"
                app:tint="@color/accent_blue" />

            <!-- Delete Custom File Button (Visible only for non-core custom files) -->
            <ImageButton
                android:id="@+id/editor_btn_delete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_delete_file"
                android:src="@drawable/ic_delete"
                android:visibility="gone"
                app:tint="@color/accent_red" />

            <!-- Save Checkmark Button -->
            <ImageButton
                android:id="@+id/editor_btn_save"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/save_file"
                android:src="@drawable/ic_check"
                app:tint="@color/accent_green" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Collapsible Inline Search Bar -->
    <LinearLayout
        android:id="@+id/editor_search_bar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@color/surface_variant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="@color/on_surface_muted" />

        <EditText
            android:id="@+id/editor_search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_subtle"
            android:textSize="13sp" />

        <!-- Match Counter (e.g. 2 of 5) -->
        <TextView
            android:id="@+id/editor_search_matches_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="monospace"
            android:text="@string/search_no_matches"
            android:textColor="@color/on_surface_muted"
            android:textSize="11sp" />

        <!-- Prev Match Button -->
        <ImageButton
            android:id="@+id/editor_btn_search_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous Match"
            android:src="@drawable/ic_arrow_up"
            app:tint="@color/on_surface" />

        <!-- Next Match Button -->
        <ImageButton
            android:id="@+id/editor_btn_search_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next Match"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/on_surface" />

        <!-- Close Search Button -->
        <ImageButton
            android:id="@+id/editor_btn_search_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:tint="@color/on_surface_muted" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color" />

    <!-- Source Code Text Editor -->
    <ScrollView
        android:id="@+id/editor_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/code_editor_bg"
        android:fillViewport="true">

        <EditText
            android:id="@+id/editor_code_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:hint="Type code here..."
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:padding="16dp"
            android:textColor="#E6EDF3"
            android:textColorHint="#484F58"
            android:textSize="13sp" />
    </ScrollView>

</LinearLayout>
