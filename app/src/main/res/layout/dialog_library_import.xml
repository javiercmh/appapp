<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp"
    app:cardElevation="0dp" app:strokeColor="@color/border_color" app:strokeWidth="1dp">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@null" android:src="@drawable/ic_download" app:tint="@color/accent_blue" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/library_import" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/on_surface" android:accessibilityHeading="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/library_import_subtitle" android:textSize="12sp" android:textColor="@color/on_surface_muted" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/import_close" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="12dp" android:contentDescription="@string/close" app:icon="@drawable/ic_close" app:iconPadding="0dp" app:iconTint="@color/on_surface_muted" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="@color/border_color" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/library_import_github" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/on_surface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/library_github_instructions" android:textSize="12sp" android:textColor="@color/on_surface_muted" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/github_url_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/library_import_url_label" app:boxBackgroundColor="@color/code_editor_bg" app:boxStrokeColor="@color/accent_blue" app:hintTextColor="@color/on_surface_muted" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/github_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textUri|textNoSuggestions" android:singleLine="true" android:importantForAutofill="no" android:textColor="@color/on_surface" android:textSize="14sp" android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/import_github" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:backgroundTint="@color/surface_elevated" android:text="@string/library_import_github_action" android:textAllCaps="false" android:textColor="@color/on_surface" app:icon="@drawable/ic_download" app:iconTint="@color/accent_blue" app:cornerRadius="12dp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="20dp" android:background="@color/border_color" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/library_import_zip" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/on_surface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/library_import_zip_desc" android:textSize="12sp" android:textColor="@color/on_surface_muted" />
            <com.google.android.material.button.MaterialButton android:id="@+id/import_zip" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="10dp" android:text="@string/library_import_choose_zip" android:textAllCaps="false" android:textColor="@color/on_surface" app:backgroundTint="@color/surface_elevated" app:icon="@drawable/ic_archive" app:iconTint="@color/accent_blue" app:cornerRadius="12dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>
