<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="0dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/library_title"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
        android:textColor="@color/on_surface" />

    <TextView
        android:id="@+id/reorder_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/library_subtitle"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/on_surface_muted" />

    <LinearLayout
        android:id="@+id/app_count_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/app_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textColor="@color/on_surface_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/check_app_updates"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="48dp"
            android:paddingHorizontal="10dp"
            android:text="@string/updates_check_short"
            android:textAllCaps="false"
            android:textColor="@color/accent_blue"
            app:icon="@drawable/ic_refresh"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@color/accent_blue" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:text="@string/library_first_app"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="@color/on_surface"
        android:visibility="gone" />

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:text="@string/library_empty"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="@color/on_surface_muted"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/empty_browse_apps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp"
        android:minHeight="48dp"
        android:text="@string/marketplace_browse_apps"
        android:textAllCaps="false"
        android:textColor="@color/on_primary"
        android:visibility="gone"
        app:backgroundTint="@color/primary"
        app:cornerRadius="999dp"
        app:icon="@drawable/ic_nav_discover"
        app:iconTint="@color/on_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/empty_import_app"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minHeight="48dp"
        android:text="@string/library_import_title"
        android:textAllCaps="false"
        android:visibility="gone"
        app:cornerRadius="999dp"
        app:icon="@drawable/ic_add" />
</LinearLayout>
