<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/settings_root"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/settings_btn_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/on_surface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="@color/on_surface" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="@color/surface_variant" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:id="@+id/settings_ai_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI services" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/on_surface" />
                            <TextView android:id="@+id/settings_tv_ai_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="No services added" android:textColor="@color/on_surface_muted" android:textSize="13sp" android:accessibilityLiveRegion="polite" />
                        </LinearLayout>
                        <ImageView android:id="@+id/settings_iv_ai_chevron" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_arrow_down" android:importantForAccessibility="no" app:tint="@color/on_surface_muted" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/settings_ai_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:visibility="gone">
                        <LinearLayout android:id="@+id/settings_group_chatgpt" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <ImageView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:background="@drawable/bg_ai_provider_icon"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_chatgpt"
                                    android:importantForAccessibility="no" />
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="12dp"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="ChatGPT"
                                        android:textColor="@color/on_surface"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />
                                    <TextView
                                        android:id="@+id/settings_tv_ai_connection"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Not connected"
                                        android:textColor="@color/on_surface_muted"
                                        android:textSize="12sp"
                                        android:accessibilityLiveRegion="polite" />
                                </LinearLayout>
                                <ImageButton
                                    android:id="@+id/settings_btn_ai_more"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="ChatGPT connection options"
                                    android:src="@drawable/ic_more_vertical"
                                    app:tint="@color/on_surface_muted" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/settings_tv_ai_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="Connect your account to use AI in your apps."
                                android:textColor="@color/on_surface_muted"
                                android:textSize="13sp"
                                android:accessibilityLiveRegion="polite" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/settings_btn_ai_signin"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:minHeight="48dp"
                                android:text="Connect ChatGPT" />
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="@color/border_color" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/settings_group_openrouter" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <ImageView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:background="@drawable/bg_ai_provider_icon"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_openrouter"
                                    android:importantForAccessibility="no"
                                    app:tint="@color/on_surface" />
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="12dp"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="OpenRouter"
                                        android:textColor="@color/on_surface"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />
                                    <TextView
                                        android:id="@+id/settings_tv_openrouter_connection"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Not connected"
                                        android:textColor="@color/on_surface_muted"
                                        android:textSize="12sp"
                                        android:accessibilityLiveRegion="polite" />
                                </LinearLayout>
                                <ImageButton
                                    android:id="@+id/settings_btn_openrouter_more"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="OpenRouter connection options"
                                    android:src="@drawable/ic_more_vertical"
                                    app:tint="@color/on_surface_muted" />
                            </LinearLayout>
                            <TextView android:id="@+id/settings_tv_openrouter_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Not connected" android:textColor="@color/on_surface_muted" android:textSize="13sp" android:accessibilityLiveRegion="polite" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/settings_btn_openrouter_key" style="@style/Widget.Material3.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="Add OpenRouter key" />
                            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/settings_switch_openrouter_paid" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Allow paid OpenRouter models" android:textColor="@color/on_surface" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Free models have rate and daily limits and may be unavailable. Paid models use your OpenRouter credits. Prices are checked before generation." android:textColor="@color/on_surface_muted" android:textSize="12sp" />
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="@color/border_color" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/settings_group_custom" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:layout_marginEnd="12dp"
                                    android:background="@drawable/bg_ai_provider_icon"
                                    android:contentDescription="@null"
                                    android:padding="10dp"
                                    android:src="@drawable/ic_terminal"
                                    app:tint="@color/accent_blue" />
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Custom endpoint" android:textColor="@color/on_surface" android:textSize="17sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/settings_tv_custom_connection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Not connected" android:textColor="@color/on_surface_muted" android:textSize="12sp" android:accessibilityLiveRegion="polite" />
                                </LinearLayout>
                                <ImageButton android:id="@+id/settings_btn_custom_more" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Custom endpoint options" android:src="@drawable/ic_more_vertical" app:tint="@color/on_surface_muted" />
                            </LinearLayout>
                            <TextView android:id="@+id/settings_tv_custom_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Add any OpenAI-compatible service by its HTTPS URL and API key." android:textColor="@color/on_surface_muted" android:textSize="13sp" android:accessibilityLiveRegion="polite" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/settings_btn_custom_set" style="@style/Widget.Material3.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="Add custom endpoint" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Uses the /models and /chat/completions routes. Prompts from your apps are sent to this service, which applies its own billing and privacy terms." android:textColor="@color/on_surface_muted" android:textSize="12sp" />
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="@color/border_color" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/settings_btn_ai_add" style="@style/Widget.Material3.Button.OutlinedButton.Icon" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Add another service" app:icon="@drawable/ic_add" />
                        <LinearLayout android:id="@+id/settings_group_exposure" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="@color/border_color" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Available to subapps" android:textColor="@color/on_surface" android:textSize="17sp" android:textStyle="bold" />
                            <TextView android:id="@+id/settings_tv_ai_exposure" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/on_surface_muted" android:textSize="13sp" android:accessibilityLiveRegion="polite" />
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/settings_input_ai_exposure"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:hint="Provider">
                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/settings_dropdown_ai_exposure"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:importantForAutofill="no"
                                    android:minHeight="48dp"
                                    android:textColor="@color/on_surface" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="@color/border_color" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Request limit per app" android:textColor="@color/on_surface" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:id="@+id/settings_tv_ai_start_limit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/on_surface_muted" android:textSize="13sp" android:accessibilityLiveRegion="polite" />
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="Requests per minute">
                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/settings_dropdown_ai_start_limit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:importantForAutofill="no"
                                android:minHeight="48dp"
                                android:textColor="@color/on_surface" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 1. Version History Retention Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/settings_history_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:screenReaderFocusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_history_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:id="@+id/settings_history_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_end"
                        app:tint="@color/on_surface_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Notification Permission Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_notifications"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:id="@+id/settings_tv_notification_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_notifications_allowed"
                        android:textColor="@color/accent_green"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp"
                        android:text="@string/settings_section_notifications_desc"
                        android:textColor="@color/on_surface_muted"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_btn_notification_permission"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/settings_notifications_allow"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface"
                        app:backgroundTint="@color/surface_variant"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_notifications"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/accent_blue" />

                    <TextView
                        android:id="@+id/settings_tv_exact_alarm_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_exact_alarms_allowed"
                        android:textColor="@color/accent_green"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_btn_exact_alarm_permission"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/settings_exact_alarms_allow"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface"
                        app:backgroundTint="@color/surface_variant"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_notifications"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/accent_blue" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Backup and restore -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/backup_description"
                        android:textColor="@color/on_surface_muted"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_backup_export"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/backup_export"
                        android:textAllCaps="false"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settings_backup_restore"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/backup_restore"
                        android:textAllCaps="false"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Compact, Aligned About App² Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/settings_card_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/settings_section_about"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/on_surface" />

                    <!-- App Version Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_app_version_label"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/settings_tv_app_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:text="1.0 (Build 1)"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- WebView Version Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_webview_version_label"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/settings_tv_webview_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:text="System Default"
                            android:textColor="@color/on_surface"
