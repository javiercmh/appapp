                <TextView android:id="@+id/app_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/on_surface" android:breakStrategy="simple" />
                <TextView android:id="@+id/app_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/on_surface_muted" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/app_menu" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" app:srcCompat="@drawable/ic_more_vertical" app:tint="@color/on_surface_muted" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
