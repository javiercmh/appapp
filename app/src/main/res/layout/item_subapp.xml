            <com.google.android.material.button.MaterialButton android:id="@+id/edit_app" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:minHeight="48dp" android:text="@string/action_edit_code" android:textAllCaps="false" android:textColor="@color/accent_blue" app:icon="@drawable/ic_code" app:iconTint="@color/accent_blue" app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
