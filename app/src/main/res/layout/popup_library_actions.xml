<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="196dp"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <LinearLayout android:id="@+id/rename_app" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp" android:background="?attr/selectableItemBackground" android:focusable="true" android:clickable="true">
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_rename"
        android:tint="@color/on_surface"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/library_rename"
        android:textColor="@color/on_surface"
        android:textSize="16sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/delete_app" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp" android:background="?attr/selectableItemBackground" android:focusable="true" android:clickable="true">
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_delete"
        android:tint="@color/error"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/library_delete"
        android:textColor="@color/error"
        android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
