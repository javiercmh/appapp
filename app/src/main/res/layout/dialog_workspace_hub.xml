<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hub_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top Action Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/hub_header"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:minWidth="320dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- Leading Close Button (X) -->
            <ImageButton
                android:id="@+id/hub_btn_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close"
                app:tint="@color/on_surface" />

            <!-- Title & Subtitle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_editor_title"
                    android:textColor="@color/on_surface"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hub_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App² Project"
                    android:textColor="@color/on_surface_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- History Button -->
            <ImageButton
                android:id="@+id/hub_btn_history"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_history"
                android:src="@drawable/ic_history"
                app:tint="@color/accent_blue" />

            <!-- Share & Package Button -->
            <ImageButton
                android:id="@+id/hub_btn_package"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_package_share"
                android:src="@drawable/ic_import_export"
                app:tint="@color/accent_blue" />

            <!-- Run Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hub_btn_run"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/primary"
                android:paddingHorizontal="16dp"
                android:text="@string/action_compile_run"
                android:textColor="@color/on_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_play"
                app:iconPadding="4dp"
                app:iconSize="16dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color" />

    <!-- Scrollable Workspace Body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- App Identity & Configuration Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hub_app_config_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/surface_variant"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- App Icon Preview (Defaults to App² logo) -->
                        <ImageView
                            android:id="@+id/hub_app_icon_preview"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_icon_preview"
                            android:clipToOutline="true"
                            android:contentDescription="@string/app_icon_label"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_app_logo" />

                        <!-- App Name & Description -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/hub_app_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="App² Project"
                                android:textColor="@color/on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/hub_app_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="On-device app built with App²"
                                android:textColor="@color/on_surface_muted"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/border_color" />

                    <!-- Configure App Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/hub_btn_configure_app"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/app_config_btn"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/surface_elevated"
                        app:icon="@drawable/ic_tune"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/accent_blue" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Project Files & Directory Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/project_files_header"
                    android:textColor="@color/accent_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hub_file_count_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tab_selected"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="4 files"
                    android:textColor="@color/on_surface_muted"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- New File Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hub_btn_new_file"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/action_new_file"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_add"
                    app:iconPadding="4dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/accent_blue" />
            </LinearLayout>

            <!-- Dynamic Files List Container -->
            <LinearLayout
                android:id="@+id/hub_files_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
