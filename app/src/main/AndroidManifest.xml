<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions, the AI service, notification receivers and the file provider come from :runtime. -->
    <application
        android:name=".ai.AppAiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RuntimeWebCompiler"
        android:hardwareAccelerated="true"
        tools:targetApi="31">
        <activity
            android:name=".SubappLibraryActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported for already pinned shortcuts from the former single-workspace release. -->
        <activity-alias android:name=".MainActivity" android:targetActivity=".SubappLibraryActivity" android:exported="true" />
        <!-- Rotation and resizing only resize the page: recreating the activity would destroy the WebView, its history and its AI session. -->
        <activity
            android:name=".SubappRuntimeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="standard"
            android:documentLaunchMode="intoExisting"
            android:maxRecents="50">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${appLinkScheme}" android:host="subapp" />
            </intent-filter>
        </activity>
    </application>

</manifest>
